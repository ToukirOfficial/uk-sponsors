{
  "name": "uk-sponsors",
  "version": "0.1.0",
  "description": "Search the UK Home Office register of licensed visa sponsors from the command line: by name, city, visa route and industry.",
  "keywords": [
    "uk",
    "visa",
    "visa-sponsorship",
    "sponsor",
    "sponsor-licence",
    "skilled-worker",
    "home-office",
    "companies-house",
    "sic-codes",
    "immigration",
    "job-search",
    "cli"
  ],
  "license": "MIT",
  "author": "Toukir Ahmed Rony (https://github.com/ToukirOfficial)",
  "homepage": "https://github.com/ToukirOfficial/uk-sponsors#readme",
  "bugs": {
    "url": "https://github.com/ToukirOfficial/uk-sponsors/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToukirOfficial/uk-sponsors.git"
  },
  "type": "module",
  "bin": {
    "uk-sponsors": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
